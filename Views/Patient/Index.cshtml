@model List<PatientManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>All Patients</h2>
        <a href="/Patient/Create" class="btn btn-primary">+ Add New Patient</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.PatientId</td>
                    <td>@patient.Name</td>
                    <td>@patient.Age</td>
                    <td>@patient.Gender</td>
                    <td>@patient.Phone</td>
                    <td>@patient.Address</td>
                    <td>
                        <a href="/Patient/Delete/@patient.PatientId"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Delete this patient?')">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>