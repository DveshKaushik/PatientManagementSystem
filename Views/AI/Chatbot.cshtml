@{
    ViewData["Title"] = "AI Chatbot";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Header -->
            <div class="card shadow mb-4">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">💬 AI Dashboard Assistant</h4>
                    <small>Ask anything about your patients, doctors and appointments</small>
                </div>
                <div class="card-body">

                    <!-- Example questions -->
                    <div class="mb-3">
                        <p class="text-muted mb-2"><small>Try asking:</small></p>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-light text-dark border">
                                How many patients do we have?
                            </span>
                            <span class="badge bg-light text-dark border">
                                List all doctors
                            </span>
                            <span class="badge bg-light text-dark border">
                                Who has appointments scheduled?
                            </span>
                            <span class="badge bg-light text-dark border">
                                Which doctor has the most appointments?
                            </span>
                        </div>
                    </div>

                    <!-- Input form -->
                    <form method="post" action="/AI/Chatbot">
                        <div class="input-group">
                            <input type="text"
                                   name="message"
                                   class="form-control form-control-lg"
                                   placeholder="Ask anything about your data..."
                                   value="@ViewBag.Message"
                                   required />
                            <button type="submit" class="btn btn-primary btn-lg">
                                Ask AI
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- AI Response -->
            @if (ViewBag.Response != null)
            {
                <div class="card shadow border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">🤖 AI Response</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-2">
                            <strong>You asked:</strong> @ViewBag.Message
                        </p>
                        <hr />
                        <p class="fs-5">@ViewBag.Response</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>