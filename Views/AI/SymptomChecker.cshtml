@{
    ViewData["Title"] = "AI Symptom Checker";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Header -->
            <div class="card shadow mb-4">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">🤖 AI Symptom Checker</h4>
                    <small>Describe your symptoms and AI will suggest the right doctor</small>
                </div>
                <div class="card-body">
                    <form method="post" action="/AI/SymptomChecker">
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Describe your symptoms:
                            </label>
                            <textarea 
                                name="symptoms" 
                                class="form-control" 
                                rows="4"
                                placeholder="Example: I have been experiencing chest pain, shortness of breath and fatigue for the past 3 days..."
                                required>@ViewBag.Symptoms</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            🔍 Analyze Symptoms
                        </button>
                    </form>
                </div>
            </div>

            <!-- AI Result -->
            @if (ViewBag.Specialization != null)
            {
                <div class="card shadow mb-4 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">✅ AI Recommendation</h5>
                    </div>
                    <div class="card-body">
                        <p class="fs-5">Based on your symptoms, you should visit a:</p>
                        <h3 class="text-success fw-bold">
                            @ViewBag.Specialization
                        </h3>
                    </div>
                </div>

                <!-- Matching Doctors -->
                @if (ViewBag.Doctors != null && 
                     ((List<PatientManagementSystem.Models.Doctor>)ViewBag.Doctors).Count > 0)
                {
                    <div class="card shadow">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                👨‍⚕️ Available Doctors — @ViewBag.Specialization
                            </h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Specialization</th>
                                        <th>Phone</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doctor in 
                                        (List<PatientManagementSystem.Models.Doctor>)ViewBag.Doctors)
                                    {
                                        <tr>
                                            <td>@doctor.Name</td>
                                            <td>@doctor.Specialization</td>
                                            <td>@doctor.Phone</td>
                                            <td>
                                                <a href="/Appointment/Create" 
                                                   class="btn btn-success btn-sm">
                                                    Book Appointment
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        No doctors found for @ViewBag.Specialization. 
                        <a href="/Doctor/Create">Add a doctor</a> with this specialization.
                    </div>
                }
            }
        </div>
    </div>
</div>