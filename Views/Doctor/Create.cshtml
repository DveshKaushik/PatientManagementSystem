@model PatientManagementSystem.Models.Doctor

@{
    ViewData["Title"] = "Add Doctor";
}

<div class="container mt-4">
    <h2>Add New Doctor</h2>
    <hr />

    <form method="post" action="/Doctor/Create">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" name="Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Specialization</label>
            <input type="text" name="Specialization" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input type="text" name="Phone" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success">Save Doctor</button>
        <a href="/Doctor/Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>